# API Configuration
NODE_ENV=development
PORT=3000


# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-anon-public-key

# CORS (aceita uma ou múltiplas origens separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Mapbox (Directions API no backend — mesmo token de acesso público da conta Mapbox)
# https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# API Documentation
API_TITLE=Koda API
API_VERSION=1.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin Seed (criação automática do administrador na inicialização)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@koda.com
ADMIN_PASSWORD=sua-senha-segura-aqui

# Email Service (Opção 1: Gmail SMTP / Opção 2: Resend)
# Gmail SMTP (Recomendado sem domínio próprio - requer Senha de App da conta Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-16-digitos

# Resend API (Alternativa caso possua domínio próprio verificado)
RESEND_API_KEY=
EMAIL_FROM=Koda <onboarding@resend.dev>



